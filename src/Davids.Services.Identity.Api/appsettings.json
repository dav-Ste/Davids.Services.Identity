{
  "Oidc": {
    "Audience": "davids-services",
    "ClientId": "davids-web",
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 14,
    "AllowedRedirectUris": [
      "https://localhost/callback",
      "http://localhost/callback",
      "https://localhost/signin-customer-oidc",
      "http://localhost/signin-customer-oidc",
      "https://localhost:17320/signin-customer-oidc",
      "http://localhost:17320/signin-customer-oidc"
    ],
    "AllowedPostLogoutRedirectUris": [
      "https://localhost/",
      "http://localhost/",
      "https://localhost:17320/",
      "http://localhost:17320/"
    ]
  },
  "AdminOidc": {
    "Audience": "davids-admin"
  },
  "RateLimiting": {
    "AuthPermitLimit": 20,
    "WindowSeconds": 60
  },
  "Lockout": {
    "MaxFailedAccessAttempts": 5,
    "DurationMinutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
