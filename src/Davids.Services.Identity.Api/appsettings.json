{
  "Oidc": {
    "Audience": "davids-services",
    "ClientId": "davids-web",
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 14,
    "AllowedRedirectUris": [
      "https://localhost/callback",
      "http://localhost/callback"
    ],
    "AllowedPostLogoutRedirectUris": [
      "https://localhost/",
      "http://localhost/"
    ]
  },
  "RateLimiting": {
    "AuthPermitLimit": 20,
    "WindowSeconds": 60
  },
  "Lockout": {
    "MaxFailedAccessAttempts": 5,
    "DurationMinutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
